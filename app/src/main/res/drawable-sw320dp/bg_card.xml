<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass card background (phone only, sw >= 320dp).
     Simulates iOS26 Liquid-Glass water-droplet look with NO real-time blur:
     translucent white fill + brighter top sheen gradient + bright edge rim.
     Watch keeps the simple drawable/bg_card.xml (solid white + gray border). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent glass body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <!-- Top sheen: brighter white at the top fading to transparent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <!-- Bright edge highlight (subtle rim) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/card_corner" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
