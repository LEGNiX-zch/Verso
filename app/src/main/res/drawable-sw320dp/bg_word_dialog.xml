<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass window background for the word dialog (phone only, sw >= 320dp).
     Translucent white fill + top sheen + bright rim, evoking iOS26 Liquid-Glass
     with NO real-time blur. Watch keeps the default AlertDialog window background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent glass body (85% white for dialog readability) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top sheen: brighter white at the top fading to transparent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Bright edge highlight (subtle rim, slightly thicker for dialog scale) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
