<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass button: translucent white with border, turns blue-tinted when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_btn_pressed" />
            <corners android:radius="@dimen/glass_radius_sm" />
            <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_btn_start"
                android:endColor="@color/glass_btn_end"
                android:angle="90" />
            <corners android:radius="@dimen/glass_radius_sm" />
            <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_btn_border" />
        </shape>
    </item>
</selector>
