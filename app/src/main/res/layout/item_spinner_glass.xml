<?xml version="1.0" encoding="utf-8"?>
<!-- Custom spinner item: shows a blue selection ring when selected (state_activated).
     Used by GlassSpinnerAdapter so the user can clearly see which card set is active. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_spinner_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/definition_text"
        android:singleLine="true"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
